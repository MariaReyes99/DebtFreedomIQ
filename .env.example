# DebtFreedomIQ — copy to .env.local and fill in. See docs/KEYS_GUIDE.md for where to find each value.

# ── Supabase (Project Settings → API Keys) ── required for accounts & saving
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server only — never share
# (Older projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY instead)

# ── OpenAI ── optional. Without it, the app uses its built-in rules engine.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-terra                   # any Responses-API model that supports structured outputs

# ── Payments ── "mock" (default) = demo checkout, no money taken. "stripe" = real Stripe Checkout.
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=sk_test_...                # needed only when PAYMENTS_MODE=stripe
STRIPE_WEBHOOK_SECRET=whsec_...              # needed only when PAYMENTS_MODE=stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... # not used yet (Stripe-hosted Checkout); kept for future embedded payments

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com                 # can open /admin (insights from your first 100 users)
HARDSHIP_WAIVER=true                         # show "Can't afford it? Get it free" on Pricing

# ── Local help listings (optional) ── shows nearby services with phone/website/directions on Find Help.
# Without it, each help type shows a Google Maps search link for the person's town instead.
GOOGLE_PLACES_API_KEY=

# ── Billing ──
# Turn on Premium Plus monthly subscriptions (otherwise shows a waitlist)
PREMIUM_PLUS_ENABLED=false
# Protects the daily billing job (/api/billing/run). Any long random string; Vercel Cron sends it automatically.
CRON_SECRET=
# Payment reminder emails (https://resend.com → API Keys). Without it, reminders are only logged.
RESEND_API_KEY=
EMAIL_FROM=DebtFreedomIQ <billing@yourdomain.com>
# Show "Subscribe without a card (testing)" at checkout. Always on in PAYMENTS_MODE=mock. Set false/remove before launch.
ALLOW_TEST_SUBSCRIBE=false
# Footer copyright line (optional). Leave empty for "Copyright © <year> DebtFreedomIQ. All rights reserved."
NEXT_PUBLIC_COPYRIGHT_TEXT=

# Investment Research Library (opens its wealth projector already filled in from "What-if & Retirement").
# Its web address, e.g. https://library.debtfreedomiq.com — or /library if both apps share one domain.
NEXT_PUBLIC_LIBRARY_URL=https://investment-research-library-mu.vercel.app
